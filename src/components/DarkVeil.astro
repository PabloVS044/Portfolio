---
import DarkVeilReact from './react/DarkVeil.jsx';

const props = Astro.props;
---

<div class="darkveil-layer">
	<DarkVeilReact client:load {...props} />
</div>

<style is:global>
	.darkveil-layer {
		width: 100%;
		height: 100%;
	}

	.darkveil-layer > astro-island {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>
