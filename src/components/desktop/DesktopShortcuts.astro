<section class="desktop-shortcuts desktop-shortcuts--right" aria-label="Desktop secondary shortcuts">
	<button
		type="button"
		class="desktop-shortcut"
		data-music-shortcut
		aria-controls="desktop-music-window"
		aria-expanded="false"
		aria-label="Abrir Apple Music"
	>
		<img
			class="desktop-shortcut__thumb"
			src="/desktop/music.png"
			alt="Apple Music icon for Soundtrack"
			loading="eager"
			decoding="async"
		/>
		<span class="desktop-shortcut__label" data-i18n="ui.soundtrack">Soundtrack</span>
	</button>
</section>

<section class="desktop-shortcuts" aria-label="Desktop shortcuts">
	<button
		type="button"
		class="desktop-shortcut"
		data-open-terminal
		aria-controls="desktop-terminal-window"
		aria-expanded="false"
		aria-label="Abrir Terminal"
	>
		<img
			class="desktop-shortcut__thumb"
			src="/desktop/terminal.png"
			alt="Terminal icon for About Me"
			loading="eager"
			decoding="async"
		/>
		<span class="desktop-shortcut__label" data-i18n="ui.about">Sobre mi</span>
	</button>
	<button
		type="button"
		class="desktop-shortcut"
		data-open-cv
		aria-controls="desktop-cv-window"
		aria-expanded="false"
		aria-label="Abrir Mi CV"
	>
		<img
			class="desktop-shortcut__thumb"
			src="/desktop/files.png"
			alt="PDF icon for CV"
			loading="eager"
			decoding="async"
		/>
		<span class="desktop-shortcut__label" data-i18n="ui.cv">CV</span>
	</button>
	<button
		type="button"
		class="desktop-shortcut"
		data-open-obsidian
		aria-controls="desktop-obsidian-window"
		aria-expanded="false"
		aria-label="Abrir Carrera"
	>
		<img
			class="desktop-shortcut__thumb"
			src="/desktop/obsidian.png"
			alt="Obsidian icon for Carrera"
			loading="eager"
			decoding="async"
		/>
		<span class="desktop-shortcut__label" data-i18n="ui.career">Carrera</span>
	</button>
	<button
		type="button"
		class="desktop-shortcut"
		data-open-code
		aria-controls="desktop-code-window"
		aria-expanded="false"
		aria-label="Abrir Proyectos en VS Code"
	>
		<img
			class="desktop-shortcut__thumb"
			src="/desktop/projects-vscode.png"
			alt="VS Code icon for Proyectos"
			loading="eager"
			decoding="async"
		/>
		<span class="desktop-shortcut__label" data-i18n="ui.projects">Proyectos</span>
	</button>
	<button
		type="button"
		class="desktop-shortcut"
		data-skills-shortcut
		aria-controls="desktop-skills-window"
		aria-expanded="false"
		aria-label="Abrir Activity Monitor (Skills)"
	>
		<img
			class="desktop-shortcut__thumb"
			src="/desktop/skills.png"
			alt="Activity Monitor icon for Skills"
			loading="eager"
			decoding="async"
		/>
		<span class="desktop-shortcut__label" data-i18n="ui.skills">Skills</span>
	</button>
	<button
		type="button"
		class="desktop-shortcut"
		data-mail-shortcut
		aria-controls="desktop-mail-window"
		aria-expanded="false"
		aria-label="Abrir Correo (Contacto)"
	>
		<img
			class="desktop-shortcut__thumb"
			src="/desktop/contact.png"
			alt="Mail icon for Contact"
			loading="eager"
			decoding="async"
		/>
		<span class="desktop-shortcut__label" data-i18n="ui.contact">Contacto</span>
	</button>
</section>
