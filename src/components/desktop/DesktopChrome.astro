---
import "../../styles/desktop.css";
import DesktopBottomUI from "./DesktopBottomUI.astro";
import DesktopMenubar from "./DesktopMenubar.astro";
import DesktopShortcuts from "./DesktopShortcuts.astro";
import ObsidianWindow from "./ObsidianWindow.astro";
import VscodeProjectsWindow from "./VscodeProjectsWindow.astro";
import CvWindow from "./CvWindow.astro";
import TerminalWindow from "./TerminalWindow.astro";
import MusicWindow from "./MusicWindow.astro";
import SkillsWindow from "./SkillsWindow.astro";
import MailWindow from "./MailWindow.astro";
import BonziBuddy from "./BonziBuddy.astro";
---

<main class="desktop-stage">
	<DesktopMenubar />
	<DesktopShortcuts />
	<ObsidianWindow />
	<VscodeProjectsWindow />
	<CvWindow />
	<TerminalWindow />
	<MusicWindow />
	<SkillsWindow />
	<MailWindow />
	<DesktopBottomUI />
	<BonziBuddy />
</main>

<script>
	import { initDesktop } from "../../scripts/desktop.js";
	import { initI18n } from "../../scripts/i18n.js";

	initI18n();
	initDesktop();
</script>
