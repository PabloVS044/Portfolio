<section
	id="desktop-terminal-window"
	class="desktop-window desktop-window--terminal"
	data-terminal-window
	aria-hidden="true"
	hidden
>
	<div class="terminal-app" role="dialog" aria-labelledby="terminal-window-title" aria-modal="false">
		<header class="terminal-app__header" data-terminal-drag-handle>
			<div class="terminal-app__traffic-lights files-window__traffic-lights">
				<button type="button" class="files-window__traffic-light files-window__traffic-light--close" data-close-terminal aria-label="Close"><span></span></button>
				<button type="button" class="files-window__traffic-light files-window__traffic-light--minimize" data-minimize-terminal aria-label="Minimize"><span></span></button>
				<button type="button" class="files-window__traffic-light files-window__traffic-light--maximize" data-toggle-terminal-maximize aria-label="Maximize"><span></span></button>
			</div>
			<div class="terminal-app__title">
				<h2 id="terminal-window-title">pablo@portfolio:~</h2>
			</div>
			<div style="width: 4.4rem; flex-shrink: 0;"></div>
		</header>
		
		<div class="terminal-app__body" data-terminal-body>
			<div class="terminal-app__output" data-terminal-output></div>
			<div class="terminal-app__input-line">
				<span class="terminal-app__prompt">pablo@portfolio:~$ </span>
				<input type="text" class="terminal-app__input" data-terminal-input autocomplete="off" spellcheck="false" autofocus />
			</div>
		</div>
	</div>

	<div class="desktop-window__resize-handle desktop-window__resize-handle--n" data-resize-handle="n" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--e" data-resize-handle="e" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--s" data-resize-handle="s" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--w" data-resize-handle="w" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--ne" data-resize-handle="ne" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--nw" data-resize-handle="nw" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--se" data-resize-handle="se" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--sw" data-resize-handle="sw" aria-hidden="true"></div>
</section>

<style>
.terminal-app {
	display: flex;
	flex-direction: column;
	width: 100%;
	height: 100%;
	border-radius: 0.8rem;
	overflow: hidden;
	background: rgba(28, 28, 30, 0.95);
	border: 1px solid rgba(255, 255, 255, 0.1);
	box-shadow: 0 1.8rem 4rem rgba(0, 0, 0, 0.42), 0 0.25rem 0.8rem rgba(0, 0, 0, 0.16);
	backdrop-filter: blur(24px) saturate(128%);
	font-family: 'Menlo', 'Monaco', 'Courier New', monospace;
	opacity: 0;
	transform: translateY(1rem) scale(0.984);
	transform-origin: left top;
	transition: opacity 220ms ease, transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
	pointer-events: auto;
}

:global(.desktop-window[data-open='true']) .terminal-app {
	opacity: 1;
	transform: translateY(0) scale(1);
}

:global(.desktop-window[data-maximized='true']) .terminal-app {
	border-radius: 1rem;
}

.terminal-app__header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 0.6rem 0.8rem;
	background: linear-gradient(180deg, rgba(50, 50, 50, 0.8), rgba(35, 35, 35, 0.8));
	border-bottom: 1px solid rgba(0, 0, 0, 0.5);
	flex-shrink: 0;
	touch-action: none;
}

.terminal-app__title h2 {
	margin: 0;
	font-size: 0.85rem;
	font-weight: 500;
	color: rgba(244, 246, 249, 0.8);
	letter-spacing: 0.02em;
}

.terminal-app__body {
	flex: 1;
	padding: 0.8rem 1rem;
	overflow-y: auto;
	color: #e0e0e0;
	font-size: 0.85rem;
	line-height: 1.5;
	cursor: text;
}

.terminal-app__input-line {
	display: flex;
	align-items: center;
	margin-top: 0.4rem;
}

.terminal-app__prompt {
	color: #4ade80;
	margin-right: 0.5rem;
	white-space: pre;
	font-weight: bold;
}

.terminal-app__input {
	flex: 1;
	background: transparent;
	border: none;
	color: #fff;
	font-family: inherit;
	font-size: inherit;
	outline: none;
}

:global(.terminal-line) {
	margin-bottom: 0.15rem;
	word-break: break-word;
}
:global(.terminal-line--command) {
	color: #fff;
}
:global(.terminal-line--response) {
