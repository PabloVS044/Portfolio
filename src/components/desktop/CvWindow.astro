		border-bottom: 1px solid rgba(0, 0, 0, 0.4);
		font-family:
			'SF Pro Text',
			'SF Pro Display',
			-apple-system,
			BlinkMacSystemFont,
			'Helvetica Neue',
			sans-serif;
		touch-action: none;
