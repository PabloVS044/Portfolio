<section
	id="desktop-cv-window"
	class="desktop-window desktop-window--cv"
	data-cv-window
	aria-hidden="true"
	hidden
>
	<div class="cv-window" role="dialog" aria-labelledby="cv-window-title" aria-modal="false">
		<header class="cv-window__header" data-cv-drag-handle>
			<div class="cv-window__titlebar">
				<div class="cv-window__traffic-lights files-window__traffic-lights">
					<button
						type="button"
						class="files-window__traffic-light files-window__traffic-light--close"
						data-close-cv
						aria-label="Close"
					>
						<span></span>
					</button>
					<button
						type="button"
						class="files-window__traffic-light files-window__traffic-light--minimize"
						data-minimize-cv
						aria-label="Minimize"
					>
						<span></span>
					</button>
					<button
						type="button"
						class="files-window__traffic-light files-window__traffic-light--maximize"
						data-toggle-cv-maximize
						aria-label="Maximize"
					>
						<span></span>
					</button>
				</div>

				<div class="cv-window__window-title">
					<h2 id="cv-window-title">Mi CV</h2>
				</div>

				<div class="cv-window__header-actions">
					<a href="/cv.pdf" download="Mi_CV.pdf" class="cv-window__tool-button" aria-label="Descargar CV" title="Descargar">
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
							<polyline points="7 10 12 15 17 10"></polyline>
							<line x1="12" y1="15" x2="12" y2="3"></line>
						</svg>
					</a>
				</div>
			</div>
		</header>

		<div class="cv-window__body">
			<iframe 
				src="/cv.pdf" 
				title="CV PDF Viewer"
			></iframe>
		</div>
	</div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--n" data-resize-handle="n" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--e" data-resize-handle="e" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--s" data-resize-handle="s" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--w" data-resize-handle="w" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--ne" data-resize-handle="ne" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--nw" data-resize-handle="nw" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--se" data-resize-handle="se" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--sw" data-resize-handle="sw" aria-hidden="true"></div>
</section>

<style>
	.cv-window {
		display: flex;
		flex-direction: column;
		width: 100%;
		height: 100%;
		border-radius: 1.28rem;
		overflow: hidden;
		background: #323639; /* Solid dark background typical for PDF viewers */
		border: 1px solid rgba(255, 255, 255, 0.08);
		box-shadow:
			0 1.8rem 4rem rgba(0, 0, 0, 0.42),
			0 0.25rem 0.8rem rgba(0, 0, 0, 0.16),
			inset 0 1px 0 rgba(255, 255, 255, 0.06);
		opacity: 0;
		transform: translateY(1rem) scale(0.984);
		transform-origin: left top;
		transition:
			opacity 220ms ease,
			transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
		pointer-events: auto;
	}

	/* Use global selector for states controlled by JS */
	:global(.desktop-window[data-open='true']) .cv-window {
		opacity: 1;
		transform: translateY(0) scale(1);
