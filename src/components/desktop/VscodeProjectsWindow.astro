---

<section
	id="desktop-code-window"
	class="desktop-window desktop-window--code"
	data-code-window
	aria-hidden="true"
	hidden
>
	<div class="code-window" role="dialog" aria-labelledby="code-window-title" aria-modal="false">
		<h2 id="code-window-title" class="desktop-sr-only">VS Code — Proyectos</h2>

		<header class="code-window__header" data-code-drag-handle>
			<div class="code-window__framebar">
				<div class="code-window__traffic-lights files-window__traffic-lights">
					<button type="button" class="files-window__traffic-light files-window__traffic-light--close" data-close-code aria-label="Close"><span></span></button>
					<button type="button" class="files-window__traffic-light files-window__traffic-light--minimize" data-minimize-code aria-label="Minimize"><span></span></button>
					<button type="button" class="files-window__traffic-light files-window__traffic-light--maximize" data-toggle-code-maximize aria-label="Maximize"><span></span></button>
				</div>

				<div class="code-window__breadcrumbs">
					<span class="code-window__crumb-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24"><path d="M4.8 10.2 12 4.8l7.2 5.4v8.6H14v-4.6h-4v4.6H4.8z"></path></svg>
					</span>
					<span class="code-window__crumb">Projects</span>
					<span class="code-window__crumb-separator" aria-hidden="true">
						<svg viewBox="0 0 24 24"><path d="m9 6.5 6 5.5-6 5.5"></path></svg>
					</span>
					<span class="code-window__crumb code-window__crumb--current" data-code-current-project-label>{projects[0].crumb}</span>
				</div>

				<div class="code-window__tabs" aria-label="Secciones del proyecto">
					{tabs.map((tab, index) => (
						<button
							type="button"
							class={`code-window__tab ${index === 0 ? 'code-window__tab--active' : ''}`}
							data-code-tab={tab.id}
							aria-selected={index === 0 ? 'true' : 'false'}
						>
							{tab.label}
						</button>
					))}
					<button type="button" class="code-window__tab-action" aria-label="Nueva pestaña">+</button>
				</div>
			</div>
		</header>

		<div class="code-window__shell">
			<!-- Sidebar: lista de proyectos -->
			<aside class="code-window__explorer" aria-label="Lista de proyectos">
				<div class="code-window__explorer-heading">PROYECTOS</div>
				<nav class="code-window__project-list">
					{projects.map((project, index) => (
						<button
							type="button"
							class={`code-window__project-item ${index === 0 ? 'code-window__project-item--active' : ''}`}
							data-code-project={project.id}
							data-code-project-label={project.crumb}
							aria-selected={index === 0 ? 'true' : 'false'}
						>
							<span class="code-window__project-icon" aria-hidden="true">
								{project.heroIcons[0]
									? <img src={project.heroIcons[0]} alt="" width="18" height="18" />
									: <svg viewBox="0 0 24 24"><rect x="3.8" y="4.2" width="16.4" height="15.6" rx="2.6"></rect><path d="M8 9.2h3.2M8 14.4h8M14.2 9.2H16"></path></svg>
								}
							</span>
							<span class="code-window__project-name">{project.fileName}</span>
						</button>
					))}
				</nav>
			</aside>

			<!-- Contenido principal -->
			<section class="code-window__main" aria-label="Detalle del proyecto">
				{projects.map((project, projectIndex) => (
					<>
						<!-- Tab: README -->
						<article
							class="code-window__panel"
							data-code-project-panel={project.id}
							data-code-tab-panel="readme"
							style={`--code-accent: ${project.accent}; --code-accent-soft: ${project.accentSoft}; --code-glow: ${project.glow};`}
							hidden={projectIndex !== 0}
						>
							<div class="code-window__hero">
								<!-- Hero mark con iconos reales del stack -->
								<div class="code-window__hero-mark">
									{project.heroIcons.slice(0, 4).map((icon) => (
										<img src={icon} alt="" class="code-window__hero-icon" loading="lazy" />
									))}
								</div>

								<div class="code-window__hero-copy">
									<div class="code-window__hero-meta">
										<p class="code-window__eyebrow">{project.fileName}</p>
										<span class="code-window__category-badge">{project.category}</span>
									</div>
									<h3>{project.title}</h3>
									<p class="code-window__subtitle">{project.subtitle}</p>
									<p class="code-window__description">{project.description}</p>

									<div class="code-window__actions">
										{project.links.map((link, linkIndex) => (
											link.href && link.href !== '#'
												? <a href={link.href} target="_blank" rel="noopener noreferrer" class={`code-window__action ${linkIndex === 0 ? 'code-window__action--primary' : ''}`}>{link.label}</a>
												: <span class={`code-window__action code-window__action--locked`}>{link.label}</span>
										))}
									</div>
								</div>
							</div>

							<!-- Métricas -->
							<div class="code-window__metrics-row">
								{project.metrics.map((metric) => (
									<div class="code-window__metric-card">
										<span class="code-window__metric-label">{metric.label}</span>
										<strong>{metric.value}</strong>
										<span class="code-window__metric-meta">{metric.meta}</span>
									</div>
								))}
							</div>

							<!-- Overview -->
							<div class="code-window__content-block">
								<h4>Contexto</h4>
								<p>{project.overview}</p>
							</div>

							<!-- Features -->
							<div class="code-window__feature-grid">
								{project.features.map((feature) => (
									<div class="code-window__feature-card">
										<h5>{feature.title}</h5>
										<p>{feature.description}</p>
									</div>
								))}
							</div>
						</article>

						<!-- Tab: Learnings -->
						<article
							class="code-window__panel"
							data-code-project-panel={project.id}
							data-code-tab-panel="learnings"
							style={`--code-accent: ${project.accent}; --code-accent-soft: ${project.accentSoft}; --code-glow: ${project.glow};`}
							hidden
						>
							<div class="code-window__section-header">
								<p class="code-window__eyebrow">Learnings.md</p>
								<h3>Lo que este proyecto me enseñó</h3>
								<p class="code-window__description">
									Las decisiones técnicas que haría diferente, lo que funcionó mejor de lo esperado, y lo que no aparece en los tutoriales.
								</p>
							</div>

							<div class="code-window__learning-grid">
								{project.learnings.map((learning, index) => (
									<div class="code-window__learning-card">
										<span class="code-window__learning-index">0{index + 1}</span>
										<p>{learning}</p>
									</div>
								))}
							</div>
						</article>
					</>
				))}
			</section>

			<!-- Panel derecho: detalles -->
			<aside class="code-window__details" aria-label="Detalles del proyecto">
				{projects.map((project, index) => (
					<div
						class="code-window__details-panel"
						data-code-project-info={project.id}
						style={`--code-accent: ${project.accent};`}
						hidden={index !== 0}
					>
						<h4>DETALLES</h4>

						<div class="code-window__detail-group">
							<span class="code-window__detail-label">Año</span>
							<strong>{project.year}</strong>
						</div>

						<div class="code-window__detail-group">
							<span class="code-window__detail-label">Rol</span>
							<strong>{project.role}</strong>
						</div>

						<div class="code-window__detail-group">
							<span class="code-window__detail-label">Estado</span>
							<strong class={`code-window__status code-window__status--${project.statusTone}`}>
								<i></i>{project.status}
							</strong>
						</div>

						<div class="code-window__detail-group">
							<span class="code-window__detail-label">Stack</span>
							<ul class="code-window__stack-list">
								{project.stack.map((item) => {
									const icon = ICON_MAP[item];
									return (
										<li class="code-window__stack-item">
											{icon && <img src={icon} alt="" width="14" height="14" loading="lazy" />}
											{item}
										</li>
									);
								})}
							</ul>
						</div>

						<div class="code-window__detail-group">
							<span class="code-window__detail-label">Links</span>
							<div class="code-window__link-list">
								{project.links.map((link) => (
									link.href && link.href !== '#'
										? <a href={link.href} target="_blank" rel="noopener noreferrer" class="code-window__detail-link">
											{link.label}
											<svg viewBox="0 0 24 24" aria-hidden="true">
												<path d="M14 5h5v5"></path>
												<path d="M10 14 19 5"></path>
												<path d="M19 13v4a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h4"></path>
											</svg>
										</a>
										: <span class="code-window__detail-link code-window__detail-link--disabled">{link.label}</span>
								))}
							</div>
						</div>
					</div>
				))}
			</aside>
		</div>
	</div>

	<div class="desktop-window__resize-handle desktop-window__resize-handle--n" data-resize-handle="n" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--e" data-resize-handle="e" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--s" data-resize-handle="s" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--w" data-resize-handle="w" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--ne" data-resize-handle="ne" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--nw" data-resize-handle="nw" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--se" data-resize-handle="se" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--sw" data-resize-handle="sw" aria-hidden="true"></div>
</section>
