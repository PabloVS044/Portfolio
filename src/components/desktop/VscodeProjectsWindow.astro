---
const tabs = [
	{ id: 'readme', label: 'README.md' },
	{ id: 'learnings', label: 'Learnings.md' },
];

const DI = (path: string) =>
	`https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/${path}.svg`;

const ICON_MAP: Record<string, string> = {
	'React':       DI('react/react-original'),
	'Node.js':     DI('nodejs/nodejs-original'),
	'Express':     DI('express/express-original'),
	'MongoDB':     DI('mongodb/mongodb-original'),
	'PostgreSQL':  DI('postgresql/postgresql-original'),
	'Python':      DI('python/python-original'),
	'FastAPI':     DI('fastapi/fastapi-original'),
	'Docker':      DI('docker/docker-original'),
	'Nginx':       DI('nginx/nginx-original'),
	'TypeScript':  DI('typescript/typescript-original'),
	'JavaScript':  DI('javascript/javascript-original'),
	'.NET 10':     DI('dot-net/dot-net-original'),
	'Blazor':      DI('blazor/blazor-original'),
	'Supabase':    DI('supabase/supabase-original'),
	'Knex':        DI('knexjs/knexjs-original'),
	'Linux':       DI('linux/linux-original'),
	'Git':         DI('git/git-original'),
	'Astro':       DI('astro/astro-original'),
	'Next.js':     DI('nextjs/nextjs-original'),
};

const projects = [
	{
		id: 'filestodata',
		crumb: 'filestodata',
		fileName: 'FilesToData',
		title: 'FilesToData',
		category: 'Empresa · En Producción',
		subtitle: 'Pipeline enterprise para extracción de datos desde PDFs industriales',
		description:
			'Sistema interno que automatiza el ingreso manual de órdenes de producción en Apparel Links. Los PDFs llegan en español, inglés y coreano. Blazor Server + FastAPI + Azure Document Intelligence + LLM local. Todo dockerizado en servidor físico Ubuntu.',
