---
import "../../styles/MailWindow.css";

const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;
---

<article
	class="desktop-window mail-window-bg"
	data-mail-window
	data-min-width="450"
	data-min-height="400"
	aria-labelledby="mail-window-title"
	data-access-key={web3formsKey}
	hidden
>
	<header class="mail-header" data-mail-drag>
		<div class="files-window__traffic-lights">
			<button
				type="button"
				class="files-window__traffic-light files-window__traffic-light--close"
				data-mail-close
				aria-label="Close"
				><span></span>
			</button>
			<button
				type="button"
				class="files-window__traffic-light files-window__traffic-light--minimize"
				data-mail-minimize
				aria-label="Minimize"
				><span></span>
			</button>
			<button
				type="button"
				class="files-window__traffic-light files-window__traffic-light--maximize"
				data-mail-maximize
				aria-label="Maximize"
				><span></span>
			</button>
		</div>
		<div class="mail-toolbar">
			<button
				type="button"
				class="mail-tool-btn"
				id="mail-send-btn"
				aria-label="Send"
			>
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<line x1="22" y1="2" x2="11" y2="13"></line>
					<polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
				</svg>
			</button>
		</div>
	</header>

	<form
		class="mail-compose-area"
		id="mail-form"
		onsubmit="event.preventDefault();"
	>
		<div class="mail-field">
			<label>Para:</label>
			<div class="mail-recipient">pvasquezs044@gmail.com</div>
		</div>

		<div class="mail-field">
			<label for="mail-from">De:</label>
			<input
				type="email"
				id="mail-from"
				name="email"
				placeholder="tu@correo.com"
				required
			/>
		</div>

		<div class="mail-field">
			<label>Cc/Cco:</label>
			<input type="text" disabled placeholder="-" />
		</div>

		<div class="mail-field">
			<label for="mail-subject">Asunto:</label>
			<input
				type="text"
				id="mail-subject"
				name="subject"
				placeholder="Oportunidad de proyecto, saludo..."
				required
			/>
		</div>

		<div class="mail-body">
			<textarea
				id="mail-body"
				name="message"
				placeholder="Escribe tu mensaje aquí..."
				required></textarea>
		</div>
	</form>

	<div class="desktop-window__resize-handle desktop-window__resize-handle--n" data-resize-handle="n" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--e" data-resize-handle="e" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--s" data-resize-handle="s" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--w" data-resize-handle="w" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--ne" data-resize-handle="ne" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--nw" data-resize-handle="nw" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--se" data-resize-handle="se" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--sw" data-resize-handle="sw" aria-hidden="true"></div>
</article>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const sendBtn = document.getElementById("mail-send-btn");
		const form = document.getElementById("mail-form") as HTMLFormElement;
		const fromInput = document.getElementById(
			"mail-from"
		) as HTMLInputElement;
		const subjectInput = document.getElementById(
			"mail-subject"
		) as HTMLInputElement;
		const bodyInput = document.getElementById(
			"mail-body"
		) as HTMLTextAreaElement;
		
		const mailArticle = document.querySelector('[data-mail-window]') as HTMLElement;
		const WEB3FORMS_ACCESS_KEY = mailArticle?.dataset.accessKey;

		if (sendBtn && form && WEB3FORMS_ACCESS_KEY) {
			sendBtn.addEventListener("click", async () => {
				if (!form.checkValidity()) {
					form.reportValidity();
					return;
				}

				const originalIcon = sendBtn.innerHTML;
				sendBtn.innerHTML =
					'<span style="font-size: 12px;">Enviando...</span>';
				sendBtn.style.pointerEvents = "none";

				try {
					const response = await fetch(
						"https://api.web3forms.com/submit",
						{
							method: "POST",
							headers: {
								"Content-Type": "application/json",
								Accept: "application/json",
							},
							body: JSON.stringify({
								access_key: WEB3FORMS_ACCESS_KEY,
								email: fromInput.value,
								subject: subjectInput.value,
								message: bodyInput.value,
								from_name: "Portafolio Contacto",
							}),
						}
					);

					const result = await response.json();
					if (response.status === 200) {
						// Success
						sendBtn.innerHTML =
							'<span style="font-size: 12px; color: #34c759;">¡Enviado!</span>';
						form.reset();
						setTimeout(() => {
							const closeBtn = document.querySelector(
								"[data-mail-close]"
							) as HTMLButtonElement;
							if (closeBtn) closeBtn.click();
							sendBtn.innerHTML = originalIcon;
							sendBtn.style.pointerEvents = "auto";
						}, 2000);
					} else {
						console.error(result);
						sendBtn.innerHTML =
							'<span style="font-size: 12px; color: #ff3b30;">Error</span>';
						setTimeout(() => {
							sendBtn.innerHTML = originalIcon;
							sendBtn.style.pointerEvents = "auto";
						}, 3000);
					}
				} catch (error) {
					console.error(error);
					sendBtn.innerHTML =
						'<span style="font-size: 12px; color: #ff3b30;">Error</span>';
					setTimeout(() => {
						sendBtn.innerHTML = originalIcon;
						sendBtn.style.pointerEvents = "auto";
					}, 3000);
				}
			});
		}
	});
</script>
