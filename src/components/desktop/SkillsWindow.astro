---

<article
	class="desktop-window skills-window-bg"
	data-skills-window
	data-min-width="600"
	data-min-height="400"
	aria-labelledby="skills-window-title"
	hidden
>
	<header class="skills-header" data-skills-drag>
		<div class="files-window__traffic-lights">
			<button type="button" class="files-window__traffic-light files-window__traffic-light--close" data-skills-close aria-label="Close"><span></span></button>
			<button type="button" class="files-window__traffic-light files-window__traffic-light--minimize" data-skills-minimize aria-label="Minimize"><span></span></button>
			<button type="button" class="files-window__traffic-light files-window__traffic-light--maximize" data-skills-maximize aria-label="Maximize"><span></span></button>
		</div>
		<div class="skills-title" id="skills-window-title">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
			</svg>
			<span>Activity Monitor</span>
		</div>
	</header>

	<div class="skills-layout">
		<div class="skills-list-container">
			<table class="skills-table">
				<thead>
					<tr>
						<th>Process Name</th>
						<th>Category</th>
						<th>User</th>
						<th>PID</th>
						<th>Status</th>
					</tr>
				</thead>
				<tbody id="skills-tbody">
					{skills.map((skill) => (
						<tr class="skills-row" data-skill-id={skill.id}>
							<td>
								<div class="skill-name">
									<img src={skill.icon} alt="" class="skill-icon" loading="lazy" decoding="async" />
									{skill.name}
								</div>
							</td>
							<td>{skill.category}</td>
							<td>pablo</td>
							<td>{skill.pid}</td>
							<td>
								<div class="skill-status">
									<span class="status-dot"></span>
									Running
								</div>
							</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
		
		<aside class="skills-detail-pane">
			<div class="skill-empty-state" id="skill-empty-state">
				Select a process to view details
			</div>
			
			<div class="skill-detail-content" id="skill-detail-content" style="display: none;">
				<div class="skill-detail-header">
					<img src="" alt="" class="skill-detail-icon" id="detail-icon" />
					<div>
						<h2 class="skill-detail-title" id="detail-title">Skill Name</h2>
						<span class="skill-detail-category" id="detail-category">Category</span>
					</div>
				</div>
				<div class="skill-detail-body">
					<strong>Implementación:</strong>
					<p id="detail-description"></p>
				</div>
			</div>
		</aside>
	</div>

	<div class="desktop-window__resize-handle desktop-window__resize-handle--n" data-resize-handle="n" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--e" data-resize-handle="e" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--s" data-resize-handle="s" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--w" data-resize-handle="w" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--ne" data-resize-handle="ne" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--nw" data-resize-handle="nw" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--se" data-resize-handle="se" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--sw" data-resize-handle="sw" aria-hidden="true"></div>
</article>

<script is:inline define:vars={{ skillsData: skills }}>
	// This script runs on the client to handle row clicks
	document.addEventListener('DOMContentLoaded', () => {
		const rows = document.querySelectorAll('.skills-row');
		const emptyState = document.getElementById('skill-empty-state');
		const detailContent = document.getElementById('skill-detail-content');
		
		const detailIcon = document.getElementById('detail-icon');
		const detailTitle = document.getElementById('detail-title');
		const detailCategory = document.getElementById('detail-category');
		const detailDescription = document.getElementById('detail-description');

		rows.forEach(row => {
			row.addEventListener('click', () => {
				// Remove active class from all rows
				rows.forEach(r => r.classList.remove('active'));
				// Add active class to clicked row
				row.classList.add('active');

				// Find the skill data
				const skillId = row.getAttribute('data-skill-id');
				const skill = skillsData.find(s => s.id === skillId);

				if (skill) {
					// Update DOM
					detailIcon.src = skill.icon;
					detailTitle.textContent = skill.name;
					detailCategory.textContent = skill.category;
					detailDescription.textContent = skill.description;

					// Switch views
					emptyState.style.display = 'none';
					detailContent.style.display = 'flex';
				}
			});
		});
	});
</script>
