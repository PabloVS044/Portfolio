---
---
<section
	id="desktop-obsidian-window"
	class="desktop-window desktop-window--obsidian"
	data-obsidian-window
	aria-hidden="true"
	hidden
>
	<div class="obsidian-app" role="dialog" aria-labelledby="obsidian-window-title" aria-modal="false">
		<header class="obsidian-app__header" data-obsidian-drag-handle>
			<div class="obsidian-app__traffic-lights files-window__traffic-lights">
				<button type="button" class="files-window__traffic-light files-window__traffic-light--close" data-close-obsidian aria-label="Close"><span></span></button>
				<button type="button" class="files-window__traffic-light files-window__traffic-light--minimize" data-minimize-obsidian aria-label="Minimize"><span></span></button>
				<button type="button" class="files-window__traffic-light files-window__traffic-light--maximize" data-toggle-obsidian-maximize aria-label="Maximize"><span></span></button>
			</div>
			<div class="obsidian-app__title">
				<span class="obsidian-app__title-icon">
					<svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
				</span>
				<h2 id="obsidian-window-title">Career_Growth - 2025_ApparelLinks.md</h2>
			</div>
			<div style="width: 4.4rem; flex-shrink: 0;"></div>
		</header>
		
		<div class="obsidian-app__body">
			<!-- Sidebar -->
			<aside class="obsidian-app__sidebar">
				<div class="obsidian-app__sidebar-header">FILES</div>
				<nav class="obsidian-app__file-tree">
					<details class="obsidian-app__folder" open>
						<summary class="obsidian-app__folder-name">Experiencia</summary>
						<div class="obsidian-app__folder-content">
							<button type="button" class="obsidian-app__file obsidian-app__file--active" data-obsidian-file="empresa1">
								<svg viewBox="0 0 24 24" class="obsidian-app__file-icon"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
								2025_ApparelLinks.md
							</button>
							<button type="button" class="obsidian-app__file" data-obsidian-file="empresa2">
								<svg viewBox="0 0 24 24" class="obsidian-app__file-icon"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
								2023_Transcafe.md
							</button>
						</div>
					</details>
					
					<details class="obsidian-app__folder" open>
						<summary class="obsidian-app__folder-name">Formación</summary>
						<div class="obsidian-app__folder-content">
							<button type="button" class="obsidian-app__file" data-obsidian-file="edu">
								<svg viewBox="0 0 24 24" class="obsidian-app__file-icon"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
								Universidad.md
							</button>
							<button type="button" class="obsidian-app__file" data-obsidian-file="cert">
								<svg viewBox="0 0 24 24" class="obsidian-app__file-icon"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
								Kinal.md
							</button>
						</div>
					</details>
				</nav>
			</aside>
			
			<!-- Main Editor Area -->
			<main class="obsidian-app__editor">
				<!-- Empresa 1 View -->
				<article class="obsidian-app__document" data-obsidian-view="empresa1">
					<div class="obsidian-app__doc-header">
						<h1># Desarrollador de Software e IA</h1>
						<div class="obsidian-app__tags">
							<span class="obsidian-app__tag" style="background: rgba(59,130,246,0.2); color: #93c5fd;">#full-stack</span>
							<span class="obsidian-app__tag" style="background: rgba(34,197,94,0.2); color: #86efac;">#mlops</span>
							<span class="obsidian-app__tag" style="background: rgba(168,85,247,0.2); color: #d8b4fe;">#devops</span>
							<span class="obsidian-app__tag" style="background: rgba(249,115,22,0.2); color: #fdba74;">#on-premise</span>
						</div>
					</div>
					<div class="obsidian-app__doc-content">
						<h2>## Apparel Links S.A., Guatemala (Ene. 2025 – Actualidad)</h2>
						<p>Empresa del sector textil/apparel con operaciones en Guatemala y clientes internacionales (Corea, EEUU). Trabajo en el área de tecnología desarrollando sistemas internos, infraestructura de IA y automatización de procesos industriales.</p>
						<h2>### FilesToData — Sistema de extracción de PDFs de producción</h2>
						<ul>
							<li>Diseñé y desarrollé de cero un sistema enterprise que automatiza el ingreso de órdenes de producción desde PDFs (español, inglés, coreano) hacia el ERP.</li>
							<li>Stack: Blazor Server (.NET 10) + FastAPI (Python 3.11) + Azure Document Intelligence + MongoDB + Azure SQL. Arquitectura Clean en el backend Python.</li>
							<li>Deploy en servidor físico Ubuntu con Docker Compose, Nginx como reverse proxy y Cloudflare Tunnel para HTTPS sin abrir puertos.</li>
						</ul>
						<h2>### Servidor LLM On-Premise — Qwen3-27B-FP8</h2>
						<ul>
							<li>Monté desde cero un servidor de inferencia privado con sglang sobre hardware dedicado: Intel Xeon W7-3455, dual NVIDIA RTX Pro 6000 Blackwell, 256GB RAM.</li>
							<li>El modelo Qwen3-27B-FP8 corre con tensor parallelism en las dos GPUs. Interfaz OpenAI-compatible para integración transparente en apps existentes.</li>
							<li>Backend propio de autenticación con sistema de API keys por consumidor. Lo usan: FilesToData, apps internas web y móvil, y el equipo de devs vía OpenCode.</li>
						</ul>
						<h2>### Infraestructura y DevOps</h2>
						<ul>
							<li>Administración de servidores Linux en producción, CI/CD, gestión de contenedores con Portainer CE.</li>
							<li>Configuración de entornos de desarrollo asistido por IA para el equipo usando OpenCode con perfiles custom que apuntan al servidor LLM interno.</li>
						</ul>
					</div>
				</article>

				<!-- Empresa 2 View -->
				<article class="obsidian-app__document" data-obsidian-view="empresa2" hidden>
					<div class="obsidian-app__doc-header">
						<h1># Soporte Técnico y Desarrollo Web</h1>
						<div class="obsidian-app__tags">
							<span class="obsidian-app__tag" style="background: rgba(59,130,246,0.2); color: #93c5fd;">#experience</span>
							<span class="obsidian-app__tag" style="background: rgba(234,179,8,0.2); color: #fde047;">#it-support</span>
							<span class="obsidian-app__tag" style="background: rgba(244,63,94,0.2); color: #fda4af;">#web</span>
						</div>
					</div>
					<div class="obsidian-app__doc-content">
						<h2>## Transcafe S.A., Guatemala (Jul. 2023 – Nov. 2023)</h2>
						<p>Empresa del sector de café en Guatemala. Primer trabajo formal en tecnología, combinando soporte técnico con desarrollo web durante mi formación en Kinal.</p>
						<ul>
							<li><strong>Soporte IT:</strong> Mantenimiento, configuración y diagnóstico de equipos y redes. Punto de contacto para incidencias técnicas del personal.</li>
							<li><strong>Administración de sistemas:</strong> Monitoreo básico de servidores y gestión de disponibilidad de servicios internos.</li>
							<li><strong>Desarrollo web:</strong> Mejoras y mantenimiento del sitio web corporativo. Primera experiencia real trabajando con código en un entorno de producción.</li>
						</ul>
					</div>
				</article>

				<!-- Edu View -->
				<article class="obsidian-app__document" data-obsidian-view="edu" hidden>
					<div class="obsidian-app__doc-header">
						<h1># Universidad del Valle de Guatemala</h1>
						<div class="obsidian-app__tags">
							<span class="obsidian-app__tag" style="background: rgba(59,130,246,0.2); color: #93c5fd;">#cs</span>
							<span class="obsidian-app__tag" style="background: rgba(34,197,94,0.2); color: #86efac;">#beca</span>
						</div>
					</div>
					<div class="obsidian-app__doc-content">
						<h2>## Ingeniería en Ciencias de la Computación y TI (2024 – 2028)</h2>
						<p>Carrera de ingeniería en una de las universidades más exigentes de Centroamérica. Cursando tercer año mientras trabajo full-time en Apparel Links.</p>
						<h2>### Beca por mérito académico</h2>
						<ul>
							<li>Becario del Programa de Becas Universitarias de la <strong>Fundación Juan Bautista Gutiérrez</strong>, otorgada por rendimiento académico sobresaliente y liderazgo estudiantil.</li>
						</ul>
						<h2>### Hackatón Copernicus 2025 — 1er Lugar</h2>
						<ul>
							<li>Primer lugar nacional en la Hackatón organizada por <strong>SENACYT</strong> usando datos satelitales del programa espacial europeo Copernicus.</li>
							<li>Proyecto: <strong>WaterWay+</strong> — plataforma de monitoreo del Río Motagua con datos Sentinel-2, reportes ciudadanos geolocalizados y análisis con OpenAI. Construido en 48 horas.</li>
						</ul>
					</div>
				</article>

				<!-- Certs View -->
				<article class="obsidian-app__document" data-obsidian-view="cert" hidden>
					<div class="obsidian-app__doc-header">
						<h1># Centro Educativo Técnico Laboral Kinal</h1>
						<div class="obsidian-app__tags">
							<span class="obsidian-app__tag" style="background: rgba(168,85,247,0.2); color: #d8b4fe;">#técnico</span>
						</div>
					</div>
					<div class="obsidian-app__doc-content">
						<h2>## Perito en Computación (2021 – 2023)</h2>
						<p>Formación técnica de tres años donde construí las bases sólidas que luego apliqué en mi carrera profesional. Kinal es uno de los centros técnicos de referencia en Guatemala.</p>
						<ul>
							<li><strong>Fundamentos de programación:</strong> Lógica, algoritmos, estructuras de datos y primeros proyectos en lenguajes como Java y C.</li>
							<li><strong>Bases de datos:</strong> Diseño relacional, SQL, MySQL — base de lo que hoy aplico en proyectos como ChemiQ y FilesToData.</li>
							<li><strong>Redes y sistemas:</strong> Configuración de redes, administración básica de sistemas operativos y servidores. Punto de partida para el trabajo actual en infraestructura Linux.</li>
							<li>Acá también conseguí mi primer trabajo (Transcafe) y empecé a construir portafolio mientras estudiaba.</li>
						</ul>
					</div>
				</article>
			</main>
		</div>
	</div>

	<!-- resize handles -->
	<div class="desktop-window__resize-handle desktop-window__resize-handle--n" data-resize-handle="n" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--e" data-resize-handle="e" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--s" data-resize-handle="s" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--w" data-resize-handle="w" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--ne" data-resize-handle="ne" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--nw" data-resize-handle="nw" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--se" data-resize-handle="se" aria-hidden="true"></div>
	<div class="desktop-window__resize-handle desktop-window__resize-handle--sw" data-resize-handle="sw" aria-hidden="true"></div>
</section>

<style>
.obsidian-app {
	display: flex;
	flex-direction: column;
	width: 100%;
	height: 100%;
	border-radius: 0.8rem;
	overflow: hidden;
	background: rgba(30, 30, 30, 0.85);
	border: 1px solid rgba(255, 255, 255, 0.1);
	box-shadow: 0 1.8rem 4rem rgba(0, 0, 0, 0.42), 0 0.25rem 0.8rem rgba(0, 0, 0, 0.16);
	backdrop-filter: blur(24px) saturate(128%);
	font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
	opacity: 0;
	transform: translateY(1rem) scale(0.984);
	transform-origin: left top;
	transition: opacity 220ms ease, transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
	pointer-events: auto;
}

:global(.desktop-window[data-open='true']) .obsidian-app {
	opacity: 1;
	transform: translateY(0) scale(1);
}

:global(.desktop-window[data-maximized='true']) .obsidian-app {
	border-radius: 1rem;
}

.obsidian-app__header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 0.7rem 0.8rem;
	background: rgba(42, 42, 42, 0.7);
	border-bottom: 1px solid rgba(0, 0, 0, 0.5);
	flex-shrink: 0;
	touch-action: none;
}

.obsidian-app__title {
	display: flex;
	align-items: center;
	gap: 0.5rem;
}

.obsidian-app__title-icon {
	color: #9ca3af;
	display: flex;
}

.obsidian-app__title h2 {
	margin: 0;
	font-size: 0.85rem;
	font-weight: 500;
	color: #d1d5db;
	letter-spacing: 0.02em;
}

.obsidian-app__body {
	flex: 1;
	display: flex;
	overflow: hidden;
}

/* Sidebar */
.obsidian-app__sidebar {
	width: 240px;
	background: rgba(26, 26, 26, 0.6);
	border-right: 1px solid rgba(255, 255, 255, 0.05);
	display: flex;
	flex-direction: column;
	flex-shrink: 0;
}

.obsidian-app__sidebar-header {
	padding: 1rem 1.2rem 0.5rem;
	font-size: 0.7rem;
	font-weight: 700;
	color: #6b7280;
	letter-spacing: 0.1em;
}

.obsidian-app__file-tree {
	padding: 0.5rem;
	overflow-y: auto;
}

.obsidian-app__folder {
	margin-bottom: 0.2rem;
}

.obsidian-app__folder-name {
	padding: 0.3rem 0.5rem;
	font-size: 0.85rem;
	color: #d1d5db;
	font-weight: 600;
	cursor: pointer;
	list-style: none;
	display: flex;
	align-items: center;
	border-radius: 0.4rem;
	user-select: none;
}

.obsidian-app__folder-name::-webkit-details-marker {
	display: none;
}

.obsidian-app__folder-name::before {
	content: '›';
	display: inline-block;
	width: 1.2rem;
	text-align: center;
	transition: transform 150ms ease;
	color: #6b7280;
}

.obsidian-app__folder[open] > .obsidian-app__folder-name::before {
	transform: rotate(90deg);
}

.obsidian-app__folder-name:hover {
	background: rgba(255, 255, 255, 0.05);
}

.obsidian-app__folder-content {
	padding-left: 1.2rem;
	margin-top: 0.2rem;
	display: flex;
	flex-direction: column;
	gap: 0.1rem;
}

.obsidian-app__file {
	appearance: none;
	background: transparent;
	border: none;
	text-align: left;
	padding: 0.35rem 0.5rem;
	font-size: 0.85rem;
	color: #9ca3af;
	cursor: pointer;
	border-radius: 0.4rem;
	display: flex;
	align-items: center;
	gap: 0.5rem;
	transition: all 150ms ease;
}

.obsidian-app__file-icon {
	width: 14px;
	height: 14px;
	stroke: currentColor;
	fill: none;
	stroke-width: 2;
}

.obsidian-app__file:hover {
	background: rgba(255, 255, 255, 0.05);
	color: #d1d5db;
}

.obsidian-app__file--active {
	background: rgba(59, 130, 246, 0.15);
	color: #60a5fa;
}
.obsidian-app__file--active:hover {
	background: rgba(59, 130, 246, 0.2);
	color: #60a5fa;
}

/* Editor */
.obsidian-app__editor {
	flex: 1;
	background: transparent;
	overflow-y: auto;
	padding: 2rem 3rem;
}

.obsidian-app__document {
	max-width: 700px;
	margin: 0 auto;
	color: #d4d4d4;
	animation: fadeIn 200ms ease;
}

@keyframes fadeIn {
	from { opacity: 0; transform: translateY(5px); }
	to { opacity: 1; transform: translateY(0); }
}

.obsidian-app__doc-header {
	margin-bottom: 2rem;
}

.obsidian-app__doc-header h1 {
	font-size: 1.8rem;
	font-weight: 700;
	color: #e5e5e5;
	margin: 0 0 1rem 0;
}

.obsidian-app__tags {
	display: flex;
	flex-wrap: wrap;
	gap: 0.5rem;
}

.obsidian-app__tag {
	padding: 0.2rem 0.6rem;
	border-radius: 1rem;
	font-size: 0.75rem;
	font-weight: 600;
}

.obsidian-app__doc-content h2 {
	font-size: 1.2rem;
	color: #60a5fa;
	margin: 1.5rem 0 0.8rem 0;
	font-weight: 600;
}

.obsidian-app__doc-content p {
	font-size: 1rem;
	line-height: 1.6;
	margin: 0 0 1rem 0;
}

.obsidian-app__doc-content ul {
	margin: 0 0 1.5rem 0;
	padding-left: 1.5rem;
}

.obsidian-app__doc-content li {
	font-size: 1rem;
	line-height: 1.6;
	margin-bottom: 0.5rem;
}

.obsidian-app__doc-content strong {
	color: #e5e5e5;
}
</style>

<script>
	const initObsidianTabs = () => {
		const buttons = document.querySelectorAll('[data-obsidian-file]');
		const views = document.querySelectorAll('[data-obsidian-view]');
		const title = document.getElementById('obsidian-window-title');
		
		if (!buttons.length) return;

		buttons.forEach(btn => {
			btn.addEventListener('click', () => {
				const target = btn.getAttribute('data-obsidian-file');
				
				buttons.forEach(b => b.classList.remove('obsidian-app__file--active'));
				btn.classList.add('obsidian-app__file--active');
				
				if(title) {
					title.textContent = `Career_Growth - ${btn.textContent.trim()}`;
				}

				views.forEach(v => {
					if(v.getAttribute('data-obsidian-view') === target) {
						v.removeAttribute('hidden');
					} else {
						v.setAttribute('hidden', '');
					}
				});
			});
		});
	};

	document.addEventListener('DOMContentLoaded', initObsidianTabs);
</script>
